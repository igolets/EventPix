<Project>
  <!-- All third-party packages must be MIT / Apache-2.0 / BSD. Check licence before adding. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- MIT. Windows service hosting (UseWindowsService); no-op on Linux/Docker. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <!-- MIT (MailKit/MimeKit), Apache-2.0 (SQLitePCLRaw), MIT (System.*). Direct refs pin patched transitive versions. -->
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="Telegram.Bot" Version="22.10.3.3" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- MIT. Produces OpenCover XML for the SonarQube Cloud coverage import. -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- MIT. E2E tests only: drives a real browser against a real app process; never ships with the app. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
